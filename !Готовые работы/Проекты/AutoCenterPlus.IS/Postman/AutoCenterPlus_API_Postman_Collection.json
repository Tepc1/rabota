    {
      "name": "TC-11 Негативный: GET /api/customers?inn=123 → 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/customers?inn=123",
          "protocol": "http",
