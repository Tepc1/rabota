{
  "info": {
    "name": "AutoCenterPlus API — УП06 Раздел 9 (вариант 22)",
    "description": "Коллекция запросов Postman для внутреннего тестирования API ИС «Автоцентр Плюс»: позитивные, негативные и граничные тесты с автотестами.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-08 Позитивный: GET /api/customers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/customers",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "customers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Body is array', function () { pm.expect(json).to.be.an('array'); });",
              "pm.test('At least 1 customer', function () { pm.expect(json.length).to.be.above(0); });",
              "pm.test('Item has name field', function () { pm.expect(json[0]).to.have.property('name'); });"
            ]
          }
        }
      ]
    },
    {
